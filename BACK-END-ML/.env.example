PORT=3000

# Groq LLM configuration
# Buat API key di Groq Console: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TEMPERATURE=0.7
GROQ_MAX_COMPLETION_TOKENS=450

# Internal services
CLASSIFICATION_SERVICE_URL=http://localhost:8080
FER_SERVICE_URL=http://localhost:5001

# Batas confidence rendah FER. Jika di bawah nilai ini, persona kembali ke neutral_supportive
FER_PERSONA_LOW_CONFIDENCE=0.50
